# Mật khẩu phải khớp POSTGRES_PASSWORD ở .env gốc — không dùng mật khẩu mẫu ở môi trường thật
DATABASE_URL="postgresql://eapproval:eapproval@localhost:5432/eapproval?schema=public"
PORT=4000
NODE_ENV=development
# Sinh secret mạnh: openssl rand -hex 64 — KHÔNG dùng giá trị mẫu này ở môi trường thật
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="10h"
COOKIE_NAME="eapproval_token"
# Sinh cặp khoá riêng: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="change-me"
VAPID_PRIVATE_KEY="change-me"
# Nhắc hạn hồ sơ PENDING không có chuyển động quá N ngày (0 = nhắc mọi hồ sơ PENDING — chỉ dùng khi dev)
REMIND_PENDING_AFTER_DAYS=3
# Lịch chạy job nhắc hạn (cron, giờ GMT+7). Dev có thể đặt "* * * * *" để test mỗi phút
REMIND_CRON="0 8 * * *"
