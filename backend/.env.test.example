# Mẫu cấu hình test — copy thành .env.test và điền password Postgres thật của bạn.
# DB phải là eapproval_test (guard trong tests/setup.ts từ chối chạy nếu không phải).
DATABASE_URL="postgresql://eapproval:YOUR_DB_PASSWORD@localhost:5432/eapproval_test?schema=public"
JWT_SECRET="test-secret-not-for-production-0123456789abcdef"
COOKIE_NAME="eapproval_token"
NODE_ENV="test"
# lib/push.ts yêu cầu VAPID lúc import — sinh cặp test bằng:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY="<vapid-public-key-test>"
VAPID_PRIVATE_KEY="<vapid-private-key-test>"
